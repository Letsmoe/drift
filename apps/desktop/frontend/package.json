{
	"name": "desktop-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"svelte-gpui": {
		"name": "Drift",
		"id": "dev.letsmoe.drift",
		"description": "YouTube Music player",
		"icon": "../build/appicon.png",
		"categories": "AudioVideo;Audio;Player;",
		"bundle": "dist/drift.js",
		"build": "build.mjs",
		"crate": {
			"manifest": "../shell/Cargo.toml",
			"features": [
				"package"
			]
		}
	},
	"scripts": {
		"build": "bun build.mjs",
		"watch": "bun build.mjs --watch",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@neoworks-dev/config": "^0.1.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"dependencies": {
		"@phosphor-icons/core": "^2.1.1",
		"svelte": "^5.57.1"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*",
		"#pages/*": "./src/pages/*"
	}
}
