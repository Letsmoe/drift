{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"lib": ["ES2022"],
		"types": [],
		"typeRoots": [],
		"paths": {
			"@neoworks/svelte-gpui": ["../../../../svelte-gpui/runtime/index.ts"],
			"@neoworks/svelte-gpui/ui": ["../../../../svelte-gpui/runtime/ui/index.ts"],
			"@neoworks/svelte-gpui-ui": ["../../../../svelte-gpui/packages/svelte-gpui-ui/src/index.ts"]
		}
	},
	"include": [
		"src/main.ts",
		"src/Boot.svelte",
		"src/App.svelte",
		"src/env.d.ts",
		"src/pages",
		"src/lib"
	],
	// Components still written for the web (Tailwind, DOM) until they are converted; remove each line then.
	"exclude": [
		"src/lib/components/DownloadQueueRow.svelte",
		"src/lib/components/EditPlaylistDialog.svelte",
		"src/lib/components/EpisodeRow.svelte",
		"src/lib/components/TrackListControls.svelte"
	]
}
